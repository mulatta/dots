$ORIGIN mulatta.io.
$TTL 300

@ IN SOA ns1.mulatta.io. hostmaster.mulatta.io. (
  2026083007 ; serial
  3600       ; refresh
  600        ; retry
  604800     ; expire
  300        ; negative ttl
)

@   IN NS ns1.mulatta.io.
@   IN NS ns2.he.net.
@   IN NS ns3.he.net.
@   IN NS ns4.he.net.
@   IN NS ns5.he.net.
ns1 IN A    @SERVICE_IPV4@
ns1 IN AAAA @SERVICE_IPV6@

@             IN A @SERVICE_IPV4@
mail          IN A @SERVICE_IPV4@
webmail       IN A @SERVICE_IPV4@
stalwart      IN A @SERVICE_IPV4@
mta-sts       IN A @SERVICE_IPV4@
idm           IN A @SERVICE_IPV4@
vaultwarden   IN A @SERVICE_IPV4@
headscale     IN A @SERVICE_IPV4@
n8n           IN A @SERVICE_IPV4@
n8n-api       IN A @SERVICE_IPV4@
rss           IN A @SERVICE_IPV4@
paperless     IN A @SERVICE_IPV4@
paperless-api IN A @SERVICE_IPV4@
cloud         IN A @SERVICE_IPV4@
video         IN A @SERVICE_IPV4@
home          IN A @SERVICE_IPV4@
cache         IN A @SERVICE_IPV4@
mq            IN A @SERVICE_IPV4@
niks3         IN A @SERVICE_IPV4@
atuin         IN A @SERVICE_IPV4@
upterm        IN A @SERVICE_IPV4@
rad           IN A @SERVICE_IPV4@
radicle-mirror IN A @SERVICE_IPV4@
blog          IN A @SERVICE_IPV4@
links         IN A @SERVICE_IPV4@
chat          IN A @SERVICE_IPV4@
ntfy          IN A @SERVICE_IPV4@
relay         IN A @SERVICE_IPV4@
blossom       IN A @SERVICE_IPV4@
tasks         IN A @SERVICE_IPV4@
restate       IN A @SERVICE_IPV4@
restate-api   IN A @SERVICE_IPV4@
zotero        IN A @SERVICE_IPV4@
minecraft     IN A 100.64.0.1

www          IN CNAME mulatta.io.
autodiscover IN CNAME mail.mulatta.io.
autoconfig   IN CNAME mail.mulatta.io.

@    IN MX 10 mail.mulatta.io.
send IN MX 10 feedback-smtp.ap-northeast-1.amazonses.com.

@                 IN TXT "v=spf1 include:amazonses.com mx ~all"
_dmarc            IN TXT "v=DMARC1; p=quarantine; rua=mailto:dmarc@mulatta.io"
resend._domainkey IN TXT "p=MIGfMA0GCSqGSIb3DQEBAQUAA4GNADCBiQKBgQDZhMdIzvq/fPFBHZ+Cn7uJij3gNXbBKulXcMm6n2OhA3iGuNJbjAAqDUiB5TxktsOrGNLE66sszpSZsC/JBbtLnMuMpHDnf6QwomDnj1ngwQnivJB6CF5vphgHWb2qRKkbNTNKITwuEWR6LPePATHJ3oFzxQIU3gGeu4261HqpHwIDAQAB"
send              IN TXT "v=spf1 include:amazonses.com ~all"
_mta-sts          IN TXT "v=STSv1; id=20250106"
_smtp._tls        IN TXT "v=TLSRPTv1; rua=mailto:tls-reports@mulatta.io"

_caldavs._tcp  IN SRV 0 1 443 stalwart.mulatta.io.
_carddavs._tcp IN SRV 0 1 443 stalwart.mulatta.io.
