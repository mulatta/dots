{
  "extensions": [
    "!**/btw.ts",
    "!**/custom-footer.ts",
    "!**/handoff.ts",
    "!**/proc-title.ts",
    "!**/stable-settings.ts",
    "!**/tuicr.ts",
    "!**/until.ts",
    "!**/workmux-status.ts"
  ],
  "skills": ["~/.claude/skills", "-skill-creator/SKILL.md"],
  "prompts": ["~/.pi/agent/prompts"],
  "theme": "tokyonight",
  "themes": ["~/.pi/agent/themes"],
  "hideThinkingBlock": true,
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "recentModels": ["openai-codex/gpt-5.6-sol"],
  "telemetry": {
    "enabled": false,
    "noticeShown": true
  }
}
