{
  "extensions": [
    "!**/btw.ts",
    "!**/custom-footer.ts",
    "!**/handoff.ts",
    "!**/proc-title.ts",
    "!**/stable-settings.ts",
    "!**/tuicr.ts",
    "!**/until.ts",
    "!**/permission-gate/**",
    "!**/questionnaire.ts",
    "!**/slow-mode.ts",
    "!**/stash/**",
    "!**/statusline/**",
    "!**/notify/**",
    "!**/notify.ts",
    "~/.pi/agent/extensions/cd.ts",
    "~/.pi/agent/extensions/claude-md.ts",
    "~/.pi/agent/extensions/commit-context.ts",
    "~/.pi/agent/extensions/cron.ts",
    "~/.pi/agent/extensions/direnv.ts",
    "~/.pi/agent/extensions/fetch",
    "~/.pi/agent/extensions/git-rebase-env.ts",
    "~/.pi/agent/extensions/inline-bash.ts",
    "~/.pi/agent/extensions/open-pr.ts",
    "~/.pi/agent/extensions/rebase-context.ts",
    "~/.pi/agent/extensions/review-context.ts",
    "~/.pi/agent/extensions/tidy.ts",
    "~/.prime/agent/extensions/permission-gate",
    "+extensions/permission-gate/index.ts"
  ],
  "skills": ["~/.claude/skills", "-skill-creator/SKILL.md"],
  "prompts": ["~/.pi/agent/prompts"],
  "theme": "tokyonight",
  "themes": ["~/.pi/agent/themes"],
  "hideThinkingBlock": true,
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "recentModels": ["openai-codex/gpt-5.6-sol"],
  "telemetry": {
    "enabled": false,
    "noticeShown": true
  }
}
