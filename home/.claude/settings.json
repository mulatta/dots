{
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "60"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "includeGitInstructions": false,
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Bash(nix run .#hm -- switch*)",
      "Bash(nix run path:.#hm -- switch*)",
      "Bash(nix run ~/dots#hm -- switch*)",
      "Bash(nix run /Users/seungwon/dots#hm -- switch*)",
      "Bash(hm switch*)",
      "Bash(home-manager switch*)",
      "Bash(nixos-rebuild switch*)",
      "Bash(nixos-rebuild boot*)",
      "Bash(nixos-rebuild test*)",
      "Bash(nixos-rebuild activate*)",
      "Bash(darwin-rebuild switch*)",
      "Bash(darwin-rebuild boot*)",
      "Bash(darwin-rebuild test*)",
      "Bash(darwin-rebuild activate*)",
      "Bash(sudo nixos-rebuild *)",
      "Bash(sudo darwin-rebuild *)",
      "Bash(nh os switch*)",
      "Bash(nh os boot*)",
      "Bash(nh os test*)",
      "Bash(nh darwin switch*)",
      "Bash(nh home switch*)",
      "Bash(clan machines update*)",
      "Bash(clan machines install*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(sops -d *)",
      "Bash(sops --decrypt *)",
      "Bash(sops decrypt *)",
      "Bash(sops exec-env *)",
      "Bash(sops exec-file *)",
      "Bash(age -d *)",
      "Bash(age --decrypt *)",
      "Bash(clan vars get *)",
      "Bash(clan vars export *)",
      "Bash(clan secrets get *)"
    ]
  },
  "model": "opus",
  "skillOverrides": {
    "agent-slack": "name-only",
    "calendar-cli": "name-only",
    "kmap-cli": "name-only",
    "linkwarden-cli": "name-only"
  },
  "statusLine": {
    "type": "command",
    "command": "hmeter ingest claude -- ~/.claude/statusline.sh",
    "padding": 0,
    "refreshInterval": 2
  },
  "language": "korean",
  "alwaysThinkingEnabled": true,
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-2": {
      "effortLevel": "high"
    }
  },
  "autoUpdatesChannel": "latest",
  "autoDreamEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "light-daltonized",
  "autoCompactEnabled": true,
  "idleCompaction": true,
  "switchModelsOnFlag": true,
  "autoContinueAtUsageLimit": true,
  "terminalProgressBarEnabled": true,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
