#!/usr/bin/env python3
"""Show the shape of a sops secret without printing any value.

Usage:
    secret-shape [--open] FILE
    secret-shape [--open] MACHINE GENERATOR/FILE

Without --open nothing is decrypted: lengths and key names come from the
ciphertext. With --open sops decrypts in this process, and only key names,
byte lengths and the kind of each value are printed. A clan var that is
public prints its value.
"""

import argparse
import base64
import json
import re
import subprocess
import sys
from pathlib import Path
from typing import Any, NoReturn

ENC = re.compile(
    r"ENC\[AES256_GCM,data:(?P<data>[^,]*),iv:[^,]*,tag:[^,]*,type:(?P<type>\w+)\]"
)
DOTENV_LINE = re.compile(r"[A-Za-z_][A-Za-z0-9_]*=")
DOTENV_PAIR = re.compile(r"(?P<key>[A-Z_][A-Z0-9_]*)=(?P<value>.*[^=].*)")
HEX = re.compile(r"[0-9a-fA-F]+")
BASE64 = re.compile(r"[A-Za-z0-9+/]+={0,2}")

Row = tuple[str, ...]


def fail(message: str) -> NoReturn:
    sys.exit(f"secret-shape: {message}")


def find_vars() -> Path:
    for directory in [Path.cwd(), *Path.cwd().parents]:
        if (directory / "vars").is_dir():
            return directory / "vars"
    fail("no vars directory above the current directory")


def resolve_var(machine: str, var_id: str) -> Path:
    vars_dir = find_vars()
    for candidate in (
        vars_dir / "per-machine" / machine / var_id,
        vars_dir / "shared" / var_id,
    ):
        if candidate.is_dir():
            return candidate
    fail(f"no var {var_id} for {machine} under {vars_dir}")


def file_format(path: Path) -> str:
    return {".yaml": "yaml", ".yml": "yaml", ".env": "dotenv"}.get(path.suffix, "json")


def load_encrypted(path: Path, fmt: str) -> dict[str, Any]:
    if fmt == "dotenv":
        return dict(
            line.split("=", 1)
            for line in path.read_text().splitlines()
            if DOTENV_LINE.match(line) and not line.startswith("sops_")
        )
    text = path.read_text()
    if fmt == "yaml":
        text = subprocess.run(
            ["yq", "-p=yaml", "-o=json", ".", str(path)],
            check=True,
            capture_output=True,
            text=True,
        ).stdout
    try:
        document = json.loads(text)
    except json.JSONDecodeError:
        document = None
    if not isinstance(document, dict) or "sops" not in document:
        fail(f"{path} is not a sops file")
    return {key: value for key, value in document.items() if key != "sops"}


def decrypt(path: Path, input_type: str, output_type: str) -> bytes:
    result = subprocess.run(
        [
            "sops",
            "decrypt",
            "--input-type",
            input_type,
            "--output-type",
            output_type,
            str(path),
        ],
        check=False,
        capture_output=True,
    )
    if result.returncode != 0:
        reason = result.stderr.decode(errors="replace").strip().splitlines()[-1:]
        fail(f"sops could not decrypt {path}: {' '.join(reason)}")
    return result.stdout


def leaves(node: Any, prefix: str = "") -> list[tuple[str, Any]]:
    items: list[tuple[str, Any]]
    if isinstance(node, dict):
        items = list(node.items())
    elif isinstance(node, list):
        items = [(str(index), value) for index, value in enumerate(node)]
    else:
        return [(prefix, node)]
    return [
        leaf
        for key, value in items
        for leaf in leaves(value, f"{prefix}.{key}" if prefix else key)
    ]


def ciphertext_bytes(value: Any) -> Row:
    match = ENC.fullmatch(value) if isinstance(value, str) else None
    if match is None:
        return ("unencrypted",)
    return (str(len(base64.b64decode(match["data"]))), match["type"])


def kind(text: str) -> str:
    if text.startswith("-----BEGIN "):
        return "pem"
    if "\n" in text:
        return "multiline"
    if not text.isprintable():
        return "binary"
    if HEX.fullmatch(text):
        return "hex"
    if len(text) % 4 == 0 and BASE64.fullmatch(text) and re.search(r"[+/=]", text):
        return "base64"
    return "printable"


def plaintext_shape(value: Any) -> Row:
    if isinstance(value, bool):
        return (str(len(str(value).lower())), "bool")
    if isinstance(value, int | float):
        return (str(len(str(value))), type(value).__name__)
    if value is None:
        return ("0", "null")
    return (str(len(str(value).encode())), kind(str(value)))


def opaque_shape(content: bytes) -> list[Row]:
    try:
        text = content.decode()
    except UnicodeDecodeError:
        return [("bytes", str(len(content))), ("kind", "binary")]
    lines = text.splitlines()
    entries = [line for line in lines if line and not line.startswith("#")]
    pairs = [pair for line in entries if (pair := DOTENV_PAIR.fullmatch(line))]
    if lines and len(pairs) == len(entries):
        return [("format", "dotenv")] + [
            (pair["key"], *plaintext_shape(pair["value"])) for pair in pairs
        ]
    try:
        document = json.loads(text)
    except json.JSONDecodeError:
        document = None
    if isinstance(document, dict):
        return [("format", "json")] + [
            (key, *plaintext_shape(value)) for key, value in leaves(document)
        ]
    return [
        ("bytes", str(len(content))),
        ("lines", str(len(lines))),
        ("kind", kind(text.removesuffix("\n"))),
    ]


def shape(path: Path, open_: bool) -> list[Row]:
    fmt = file_format(path)
    document = load_encrypted(path, fmt)
    if fmt == "json" and set(document) == {"data"}:
        if not open_:
            return [
                ("format", "binary"),
                ("bytes", ciphertext_bytes(document["data"])[0]),
            ]
        rows = opaque_shape(decrypt(path, "binary", "binary"))
        return rows if rows[0][0] == "format" else [("format", "binary"), *rows]
    if not open_:
        return [("format", fmt)] + [
            (key, *ciphertext_bytes(value)) for key, value in leaves(document)
        ]
    plain = json.loads(decrypt(path, fmt, "json"))
    plain.pop("sops", None)
    return [("format", fmt)] + [
        (key, *plaintext_shape(value)) for key, value in leaves(plain)
    ]


def main() -> None:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument(
        "--open",
        action="store_true",
        help="decrypt in this process to show keys and kinds",
    )
    parser.add_argument("target", nargs="+", metavar="FILE | MACHINE GENERATOR/FILE")
    args = parser.parse_args()

    if len(args.target) == 2:
        path = resolve_var(*args.target)
    elif len(args.target) == 1:
        path = Path(args.target[0])
    else:
        parser.error("give a file, or a machine and a var id")

    if path.is_dir():
        if (path / "value").is_file():
            print(f"public\t{(path / 'value').read_text().strip()}")
            return
        path = path / "secret"
    if not path.is_file():
        fail(f"{path} does not exist")

    for row in shape(path, args.open):
        print("\t".join(row))


if __name__ == "__main__":
    main()
