#!/usr/bin/env bash
# gh-bootstrap — One-shot GitHub repo setup for Nix flake projects.
#
# Configures GitHub-side state that cannot live in the repository: merge and
# Actions policy, Nixbot repository enablement and its marker topic, updater App
# credentials, and Nixbot branch rulesets. The auto-merge workflow stays in the
# flake template; this script verifies that it uses github-actions[bot] and that
# gitea-mq owns
# the merge queue check.
#
# Usage:
#   gh-bootstrap                        # current repo, protect its default branch
#   gh-bootstrap owner/repo             # specific repo, protect its default branch
#   gh-bootstrap owner/repo main dev    # specific protected branches
#
# Environment:
#   GH_BOOTSTRAP_VISIBILITY             # public (default), private, or internal
#   GH_BOOTSTRAP_UPDATER_ENTRY          # rbw entry (default: github/dots-flake-updater)
#   GH_BOOTSTRAP_SKIP_UPDATER_SECRETS   # set to 1 to leave Actions secrets unchanged

set -euo pipefail

usage() {
  sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'
}

die() {
  echo "error: $*" >&2
  exit 1
}

repo_from_url() {
  local url="$1"
  local repo

  case "$url" in
    git@github.com:*) repo="${url#git@github.com:}" ;;
    ssh://git@github.com/*) repo="${url#ssh://git@github.com/}" ;;
    https://github.com/*) repo="${url#https://github.com/}" ;;
    git://github.com/*) repo="${url#git://github.com/}" ;;
    *) return 1 ;;
  esac

  repo="${repo%.git}"
  repo="${repo%/}"
  [[ "$repo" == */* ]] || return 1
  printf '%s\n' "$repo"
}

infer_repo() {
  local origin_url
  local repo
  local top

  if repo=$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null); then
    printf '%s\n' "$repo"
    return 0
  fi

  if origin_url=$(git config --get remote.origin.url 2>/dev/null) \
    && repo=$(repo_from_url "$origin_url"); then
    printf '%s\n' "$repo"
    return 0
  fi

  top=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
  printf '%s/%s\n' "$USER_LOGIN" "$(basename "$top")"
}

repo_exists() {
  gh api "repos/$REPO" --silent >/dev/null 2>&1
}

git_has_commits() {
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 \
    && git rev-parse --verify HEAD >/dev/null 2>&1
}

origin_matches_repo_or_absent() {
  local origin_url
  local origin_repo

  if ! origin_url=$(git remote get-url origin 2>/dev/null); then
    return 0
  fi

  origin_repo=$(repo_from_url "$origin_url" 2>/dev/null || true)
  [[ "$origin_repo" == "$REPO" ]]
}

ensure_origin() {
  local origin_url
  local origin_repo
  local ssh_url

  ssh_url=$(gh repo view "$REPO" --json sshUrl -q .sshUrl)

  if origin_url=$(git remote get-url origin 2>/dev/null); then
    origin_repo=$(repo_from_url "$origin_url" 2>/dev/null || true)
    if [[ "$origin_repo" == "$REPO" ]]; then
      return 0
    fi

    echo "    local origin points to $origin_url; not changing it"
    return 1
  fi

  git remote add origin "$ssh_url"
  echo "    origin: added $ssh_url"
}

push_bootstrap_branches() {
  local branch
  local current_branch
  local pushed_current=false

  git_has_commits || return 0
  ensure_origin || return 0

  current_branch=$(git branch --show-current 2>/dev/null || true)

  for branch in "${BRANCHES[@]}"; do
    if git show-ref --verify --quiet "refs/heads/$branch"; then
      git push -u origin "$branch"
      [[ "$branch" == "$current_branch" ]] && pushed_current=true
    fi
  done

  if [[ -n "$current_branch" && "$pushed_current" == false ]]; then
    git push -u origin "$current_branch"
  elif [[ -z "$current_branch" ]]; then
    git push origin HEAD
  fi
}

repo_visibility_flag() {
  case "${GH_BOOTSTRAP_VISIBILITY:-public}" in
    private) printf '%s\n' "--private" ;;
    public) printf '%s\n' "--public" ;;
    internal) printf '%s\n' "--internal" ;;
    *) die "GH_BOOTSTRAP_VISIBILITY must be private, public, or internal" ;;
  esac
}

ensure_repo() {
  local visibility_flag

  if repo_exists; then
    echo "    exists"
    return 0
  fi

  visibility_flag=$(repo_visibility_flag)
  echo "    creating ($visibility_flag)..."

  if git_has_commits && origin_matches_repo_or_absent; then
    gh repo create "$REPO" "$visibility_flag"
    push_bootstrap_branches
  else
    gh repo create "$REPO" "$visibility_flag" --add-readme
    echo "    initialized with README; local git history was not pushed"
  fi
}

install_updater_secrets() {
  local app_id
  local entry=${GH_BOOTSTRAP_UPDATER_ENTRY:-github/dots-flake-updater}

  if [[ "${GH_BOOTSTRAP_SKIP_UPDATER_SECRETS:-0}" == 1 ]]; then
    echo "    skipped"
    return 0
  fi

  app_id=$(rbw get "$entry" --field username)
  [[ "$app_id" =~ ^[0-9]+$ ]] || die "$entry username must contain the numeric App ID"

  printf '%s' "$app_id" | gh secret set APP_ID --app actions --repo "$REPO"
  unset app_id
  rbw get "$entry" --field notes \
    | gh secret set APP_PRIVATE_KEY --app actions --repo "$REPO"
  echo "    installed from rbw entry $entry"
}

check_auto_merge_workflow() {
  local response
  local workflow

  if ! response=$(gh api "repos/$REPO/contents/.github/workflows/auto-merge.yaml" 2>/dev/null); then
    echo "    warning: .github/workflows/auto-merge.yaml is missing" >&2
    return 1
  fi
  workflow=$(jq -r '.content | gsub("\\s"; "") | @base64d' <<<"$response")

  if ! grep -Eq 'repo-token:[[:space:]]*\$\{\{[[:space:]]*github\.token[[:space:]]*\}\}' <<<"$workflow"; then
    echo "    warning: auto-merge workflow does not use github.token" >&2
    return 1
  fi
  if ! grep -Eq 'approve:[[:space:]]*false([[:space:]]|$)' <<<"$workflow"; then
    echo "    warning: auto-merge workflow does not disable approval" >&2
    return 1
  fi
  if ! grep -Eq 'merge-method:[[:space:]]*merge([[:space:]]|$)' <<<"$workflow"; then
    echo "    warning: auto-merge workflow does not use merge commits" >&2
    return 1
  fi

  echo "    github-actions[bot], approval disabled, merge commits"
}

get_ruleset_details() {
  local id

  while IFS= read -r id; do
    gh api "repos/$REPO/rulesets/$id"
  done < <(gh api "repos/$REPO/rulesets" --jq '.[].id') | jq -s .
}

check_gitea_mq() {
  local details

  details=$(get_ruleset_details)

  if jq -e 'any(.[]?.rules[]?; .type == "merge_queue")' <<<"$details" >/dev/null; then
    die "GitHub built-in merge queue conflicts with gitea-mq"
  fi

  if ! jq -e '
    [
      .[]
      | select(.name == "gitea-mq")
      | select(any(.rules[]?;
          .type == "required_status_checks"
          and any(.parameters.required_status_checks[]?;
            .context == "gitea-mq" and .integration_id != null)))
      | select(any(.bypass_actors[]?; .actor_type == "Integration"))
    ]
    | length > 0
  ' <<<"$details" >/dev/null; then
    echo "    warning: gitea-mq App ruleset is not ready yet" >&2
    return 1
  fi

  echo "    App ruleset active; built-in merge queue disabled"
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

USER_LOGIN=$(gh api user --jq '.login')

if [[ $# -gt 0 ]]; then
  REPO="$1"
  shift
else
  REPO=$(infer_repo)
fi

if [[ "$REPO" != */* ]]; then
  REPO="$USER_LOGIN/$REPO"
fi

BRANCHES=("$@")

OWNER="${REPO%%/*}"
NAME="${REPO#*/}"

if [[ -z "$OWNER" || -z "$NAME" || "$OWNER" == "$NAME" ]]; then
  die "repo must be owner/name"
fi

echo "repo:      $REPO"
echo "bypass:    repository admins"
echo

echo "==> [1/7] Repository..."
ensure_repo

if [[ ${#BRANCHES[@]} -eq 0 ]]; then
  BRANCHES=("$(gh api "repos/$REPO" --jq .default_branch)")
fi
echo "    protected branches: ${BRANCHES[*]}"

echo "==> [2/7] Repository and Actions policy..."
gh api "repos/$REPO" --method PATCH --silent \
  --field allow_squash_merge=true \
  --field allow_merge_commit=true \
  --field allow_rebase_merge=true \
  --field squash_merge_commit_title=PR_TITLE \
  --field squash_merge_commit_message=PR_BODY \
  --field delete_branch_on_merge=true \
  --field allow_auto_merge=true
gh api "repos/$REPO/actions/permissions/workflow" --method PUT --silent \
  --field default_workflow_permissions=read \
  --field can_approve_pull_request_reviews=false
echo "    merge enabled; Actions read-only by default and cannot approve PRs"

echo "==> [3/7] Updater App credentials..."
install_updater_secrets

echo "==> [4/7] Nixbot..."
EXISTING_TOPICS=$(gh api "repos/$REPO/topics" --jq '.names | join(",")')
if grep -qw "build-with-buildbot" <<<"$EXISTING_TOPICS"; then
  echo "    topic: already present"
else
  ALL_TOPICS="$EXISTING_TOPICS,build-with-buildbot"
  TOPIC_JSON=$(tr ',' '\n' <<<"$ALL_TOPICS" | grep -v '^$' | jq -R . | jq -s '{"names": .}')
  gh api "repos/$REPO/topics" --method PUT --silent --input - <<<"$TOPIC_JSON"
  echo "    topic: added"
fi

nbo repo enable "github/$REPO" >/dev/null
echo "    repository: enabled"

echo "==> [5/7] Branch rulesets..."
REMOTE_BRANCHES=$(gh api --paginate "repos/$REPO/branches?per_page=100" --jq '.[].name' 2>/dev/null || true)

for BRANCH in "${BRANCHES[@]}"; do
  RULESET_NAME="${BRANCH}-protection"

  if ! grep -qx "$BRANCH" <<<"$REMOTE_BRANCHES"; then
    echo "    $RULESET_NAME: branch not found, skipping"
    continue
  fi

  PAYLOAD=$(cat <<EOF
{
  "name": "$RULESET_NAME",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": { "include": ["refs/heads/$BRANCH"], "exclude": [] }
  },
  "rules": [
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "required_status_checks": [
          { "context": "buildbot/nix-eval" },
          { "context": "buildbot/nix-build" }
        ]
      }
    },
    { "type": "deletion" },
    { "type": "non_fast_forward" }
  ],
  "bypass_actors": [
    {
      "actor_id": 5,
      "actor_type": "RepositoryRole",
      "bypass_mode": "always"
    }
  ]
}
EOF
  )

  RULESETS_JSON=$(mktemp)
  if ! gh api "repos/$REPO/rulesets" >"$RULESETS_JSON"; then
    ERROR_MESSAGE=$(jq -r '.message // empty' <"$RULESETS_JSON" 2>/dev/null || true)
    rm -f "$RULESETS_JSON"
    die "could not list rulesets for $REPO${ERROR_MESSAGE:+: $ERROR_MESSAGE}"
  fi

  EXISTING_ID=$(jq -r --arg name "$RULESET_NAME" '.[] | select(.name == $name) | .id' <"$RULESETS_JSON")
  rm -f "$RULESETS_JSON"

  if [[ -n "$EXISTING_ID" && ! "$EXISTING_ID" =~ ^[0-9]+$ ]]; then
    die "invalid ruleset id for $RULESET_NAME: $EXISTING_ID"
  fi

  if [[ -n "$EXISTING_ID" ]]; then
    gh api "repos/$REPO/rulesets/$EXISTING_ID" --method PUT --silent --input - <<<"$PAYLOAD"
    echo "    $RULESET_NAME: updated (id: $EXISTING_ID)"
  else
    gh api "repos/$REPO/rulesets" --method POST --silent --input - <<<"$PAYLOAD"
    echo "    $RULESET_NAME: created"
  fi
done

echo "==> [6/7] Auto-merge workflow..."
check_auto_merge_workflow || true

echo "==> [7/7] gitea-mq..."
check_gitea_mq || true

echo
echo "done. Verify at:"
echo "  Rules:   https://github.com/$REPO/rules"
echo "  Actions: https://github.com/$REPO/settings/actions"
echo "  Secrets: https://github.com/$REPO/settings/secrets/actions"
